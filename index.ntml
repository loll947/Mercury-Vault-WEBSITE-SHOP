<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Mercury Vault</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <div class="logo">MERCURY <span>VAULT</span></div>

        <nav>
            <a href="#home">Home</a>
            <a href="#products">Products</a>
            <a href="#features">Features</a>
            <a href="#faq">FAQ</a>
        </nav>

        <button class="login-btn" onclick="login()">
            Login
        </button>
    </header>


    <main>

        <section id="home" class="hero">

            <div class="hero-content">

                <div class="badge">
                    MERCURY VAULT
                </div>

                <h1>
                    Your Vault.<br>
                    Your <span>Advantage.</span>
                </h1>

                <p>
                    Premium tools, licenses and digital products
                    built for performance.
                </p>

                <div class="buttons">

                    <a href="#products" class="primary-btn">
                        Explore Products
                    </a>

                    <a href="#features" class="secondary-btn">
                        Learn More
                    </a>

                </div>

            </div>

        </section>


        <section id="products" class="section">

            <div class="section-title">
                <p>STORE</p>
                <h2>Our Products</h2>
            </div>


            <div class="products">

                <div class="product-card">

                    <div class="product-icon">
                        M
                    </div>

                    <h3>Mercury V1</h3>

                    <p>
                        Premium access to Mercury V1.
                    </p>

                    <div class="price">
                        $9.99
                    </div>

                    <button onclick="buyProduct('Mercury V1')">
                        Purchase
                    </button>

                </div>


                <div class="product-card featured">

                    <div class="product-icon">
                        M
                    </div>

                    <h3>Mercury V2</h3>

                    <p>
                        Advanced Mercury Vault access.
                    </p>

                    <div class="price">
                        $19.99
                    </div>

                    <button onclick="buyProduct('Mercury V2')">
                        Purchase
                    </button>

                </div>


                <div class="product-card">

                    <div class="product-icon">
                        ∞
                    </div>

                    <h3>Lifetime</h3>

                    <p>
                        Lifetime access to the product.
                    </p>

                    <div class="price">
                        $49.99
                    </div>

                    <button onclick="buyProduct('Lifetime')">
                        Purchase
                    </button>

                </div>

            </div>

        </section>


        <section id="features" class="section features-section">

            <div class="section-title">
                <p>WHY MERCURY</p>
                <h2>Built Different</h2>
            </div>


            <div class="features">

                <div class="feature">
                    <div>01</div>
                    <h3>Fast</h3>
                    <p>
                        Designed for fast and reliable access.
                    </p>
                </div>

                <div class="feature">
                    <div>02</div>
                    <h3>Secure</h3>
                    <p>
                        Your account and licenses stay protected.
                    </p>
                </div>

                <div class="feature">
                    <div>03</div>
                    <h3>Premium</h3>
                    <p>
                        A clean premium experience from start to finish.
                    </p>
                </div>

            </div>

        </section>


        <section id="faq" class="section faq">

            <div class="section-title">
                <p>FAQ</p>
                <h2>Frequently Asked Questions</h2>
            </div>

            <div class="faq-box">

                <h3>How do I purchase a product?</h3>
                <p>
                    Choose a product above and continue through the checkout.
                </p>

            </div>

            <div class="faq-box">

                <h3>Where can I see my license?</h3>
                <p>
                    Your license will be available from your Mercury Vault dashboard.
                </p>

            </div>

        </section>

    </main>


    <footer>

        <div class="logo">
            MERCURY <span>VAULT</span>
        </div>

        <p>
            © 2026 Mercury Vault. All rights reserved.
        </p>

    </footer>


    <script src="script.js"></script>

</body>
</html>
